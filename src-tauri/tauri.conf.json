{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MediaPipe Vision",
  "version": "0.1.0",
  "identifier": "com.mediapipe.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MediaPipe Desktop Vision",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
